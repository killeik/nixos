{
  "uid": "qingping-air",
  "title": "Qingping Air Monitor Lite",
  "description": "Локальные показания CGDN1 через MQTT и Prometheus. Обновление датчика раз в минуту. История накапливается с момента запуска сбора.",
  "tags": [
    "home",
    "qingping"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
