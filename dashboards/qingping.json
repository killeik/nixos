      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "qingping_co2_ppm{job=\"qingping\"}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "decimals": 0,
          "noValue": "Нет данных"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
