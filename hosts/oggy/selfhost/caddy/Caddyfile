{
	metrics {
		per_host
	}
}

# Published on host loopback only; this handler does not expose the admin API.
http://:9180 {
	metrics /metrics
}

(tls_cloudflare) {
	tls {
		dns cloudflare {env.CLOUDFLARE_API_TOKEN}
		resolvers 1.1.1.1
		propagation_delay 1m
		propagation_timeout 20m
	}
}

silverbullet.killeik.net {
	reverse_proxy silverbullet:3000
	import tls_cloudflare
}
t3.killeik.net {
	reverse_proxy 10.231.40.2:3773
	import tls_cloudflare
}
miniflux.killeik.net {
	reverse_proxy miniflux:8080
	import tls_cloudflare
}
reactflux.killeik.net {
	reverse_proxy reactflux:2000
	import tls_cloudflare
}
syncthing.killeik.net {
	reverse_proxy syncthing:8384
	import tls_cloudflare
}
forgejo.killeik.net {
	reverse_proxy forgejo:3000
	import tls_cloudflare
}
excalidash.killeik.net {
	reverse_proxy excalidash-frontend:80
	import tls_cloudflare
}
larapaper.killeik.net {
	reverse_proxy larapaper:8080
	import tls_cloudflare
}
grafana.killeik.net {
	reverse_proxy unix//run/grafana/grafana.sock {
		header_up Host {host}
	}
	import tls_cloudflare
}

http://:3000 {
	reverse_proxy unix//run/grafana/grafana.sock {
		header_up Host {host}
	}
}

headplane.killeik.net {
	@tailnet remote_ip 100.64.0.0/10 fd7a:115c:a1e0::/48
	handle @tailnet {
		redir / /admin 302
		reverse_proxy headplane:3000 {
			# Headplane stores the API key in this cookie; keep it inaccessible to scripts.
			header_down Set-Cookie "^(_hp_auth=.*)$" "$1; HttpOnly"
		}
	}
	handle {
		respond "Tailscale access required" 403
	}
	import tls_cloudflare
}
